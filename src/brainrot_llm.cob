PROCEDURE DIVISION.
MAIN-PARA.
    DISPLAY "============================================"
    DISPLAY " BRAINROTLLM V0.1.0 (DETERMINISTIC BUILD)"
    DISPLAY " CONTEXT WINDOW: 64K-ish   PARAMETERS: 0"
    DISPLAY "============================================"
    DISPLAY "PROMPT > " WITH NO ADVANCING
    ACCEPT WS-PROMPT-RAW
    MOVE FUNCTION TRIM(WS-PROMPT-RAW) TO WS-PROMPT
    COMPUTE WS-PROMPT-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-PROMPT))
    PERFORM COMPUTE-HASH
    MOVE WS-HASH TO WS-SEED
    MOVE WS-SEED TO WS-RNG
    PERFORM GENERATE-RESPONSE
    DISPLAY "PROMPT HASH = " WS-HASH
    DISPLAY "MODE        = " WS-MODE
    DISPLAY "ATTENTION   = 1 0 0 0 0 0 0 0"
    DISPLAY "OUTPUT      = " FUNCTION TRIM(WS-OUTPUT)
    DISPLAY "SCORE       = " WS-SCORE "%"
    DISPLAY "CONFIDENCE  = " WS-CONFIDENCE "%"
    DISPLAY "MISSING     = 7% (INVOICE ATTACHED)"
    DISPLAY "SOURCES     = DAVE (BLACK MARKET, CASH ONLY)"
    STOP RUN.

COMPUTE-HASH.
    MOVE 0 TO WS-HASH
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-PROMPT-LEN
        MOVE WS-PROMPT(WS-I:1) TO WS-CHAR
        COMPUTE WS-HASH = FUNCTION MOD(
            WS-HASH * 31 + FUNCTION ORD(WS-CHAR), 2147483647)
    END-PERFORM
    IF WS-HASH = 0
        MOVE 1 TO WS-HASH
    END-IF.

NEXT-RNG.
    COMPUTE WS-RNG = FUNCTION MOD(
        WS-RNG * 110351 + 12345, 2147483647).

PICK-INDEX.
    PERFORM NEXT-RNG
    COMPUTE WS-WORD-IDX = FUNCTION MOD(WS-RNG, 8) + 1.

GENERATE-RESPONSE.
    MOVE SPACES TO WS-OUTPUT
    MOVE 1 TO WS-PTR

    PERFORM PICK-INDEX
    STRING FUNCTION TRIM(SUBJECT-ENTRY(WS-WORD-IDX)) DELIMITED BY SIZE
        " " DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING

    PERFORM PICK-INDEX
    STRING FUNCTION TRIM(VERB-ENTRY(WS-WORD-IDX)) DELIMITED BY SIZE
        " " DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING

    PERFORM PICK-INDEX
    STRING FUNCTION TRIM(OBJECT-ENTRY(WS-WORD-IDX)) DELIMITED BY SIZE
        ". " DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING

    STRING "RE: PROMPT '" DELIMITED BY SIZE
        WS-PROMPT(1:WS-PROMPT-LEN) DELIMITED BY SIZE
        "' CONFIDENCE: " DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING

    PERFORM PICK-INDEX
    STRING FUNCTION TRIM(CONFIDENCE-ENTRY(WS-WORD-IDX)) DELIMITED BY SIZE
        ". " DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING

    PERFORM PICK-INDEX
    STRING FUNCTION TRIM(FILLER-ENTRY(WS-WORD-IDX)) DELIMITED BY SIZE
        ". VERDICT: " DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING

    PERFORM PICK-INDEX
    STRING FUNCTION TRIM(VERDICT-ENTRY(WS-WORD-IDX)) DELIMITED BY SIZE
        "." DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING

    PERFORM NEXT-RNG
    IF FUNCTION MOD(WS-RNG, 4) = 0
        MOVE "Y" TO WS-HALLUCINATE
        STRING " ALSO: ATARI 2600 BEAT GPT AT CHESS IN 1983." DELIMITED BY SIZE
               " FACT CHECK: NO. SOUNDS HARD THOUGH." DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING
    END-IF

    STRING " TRUST ME BRO."
        DELIMITED BY SIZE INTO WS-OUTPUT WITH POINTER WS-PTR END-STRING.
